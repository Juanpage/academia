# ═══════════════════════════════════════════════════════
# ACADEMIA MILITAR DIGITAL — Variables de Entorno
# Copiar a .env y completar los valores
# ═══════════════════════════════════════════════════════

# ─── Aplicación ──────────────────────────────────────
NODE_ENV=production
PORT=3000
CORS_ORIGINS=https://academia.tudominio.com,https://admin.tudominio.com
FRONTEND_URL=https://academia.tudominio.com
LOG_LEVEL=info

# ─── Base de Datos ────────────────────────────────────
POSTGRES_DB=academia_db
POSTGRES_USER=academia_user
POSTGRES_PASSWORD=CAMBIA_ESTO_en_produccion
DATABASE_URL=postgresql://academia_user:CAMBIA_ESTO@postgres:5432/academia_db

# ─── Redis ───────────────────────────────────────────
REDIS_PASSWORD=CAMBIA_ESTO_redis
REDIS_URL=redis://:CAMBIA_ESTO_redis@redis:6379

# ─── JWT ─────────────────────────────────────────────
JWT_SECRET=GENERA_UN_SECRET_DE_256_BITS_AQUI
JWT_EXPIRES_IN=8h

# ─── Moodle ──────────────────────────────────────────
MOODLE_DB=moodle_db
MOODLE_URL=https://moodle.tudominio.com
MOODLE_TOKEN=TOKEN_DEL_WEBSERVICE_MOODLE
MOODLE_ADMIN_PASSWORD=CAMBIA_ESTO_moodle

# ─── Email (Brevo / SMTP) ─────────────────────────────
SMTP_HOST=smtp.brevo.com
SMTP_PORT=587
SMTP_USER=tu@email.com
SMTP_PASS=TU_API_KEY_BREVO
SMTP_FROM=noreply@academia.com

# ─── Pasarelas de Pago ────────────────────────────────
PAYPHONE_API_KEY=TU_KEY_PAYPHONE
PAYPHONE_STORE_ID=TU_STORE_ID
STRIPE_SECRET_KEY=sk_live_TU_KEY_STRIPE
STRIPE_WEBHOOK_SECRET=whsec_TU_SECRET

# ─── SRI Ecuador (futura integración) ────────────────
SRI_AMBIENTE=1
SRI_RUC=0901234567001
SRI_RAZON_SOCIAL=ACADEMIA MILITAR DIGITAL S.A.
SRI_CERTIFICADO_PATH=/certs/certificado.p12
SRI_CERTIFICADO_PASS=CLAVE_CERTIFICADO
